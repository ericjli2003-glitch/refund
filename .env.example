SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Refund's own key for sealing, quote signing and customer ID hashing. Unset
# falls back to SHOPIFY_API_SECRET. When changing it, list every earlier value
# (comma-separated) in REFUND_PREVIOUS_SECRETS while records written with it exist.
REFUND_SECRET=
REFUND_PREVIOUS_SECRETS=
SHOPIFY_APP_URL=https://refund.example.com
SCOPES=read_orders,write_orders,read_customers,read_products,read_locations,read_returns,write_returns,customer_read_customers,customer_read_orders,customer_write_customers,customer_write_orders,write_app_proxy
DATABASE_URL=postgresql://refund:password@localhost:5432/refund?schema=public
PUBLIC_SUPPORT_EMAIL=
# Email confirmation for store links (Resend). The sender must be on a domain
# verified in Resend, for example: Refund <returns@yourdomain.com>
RESEND_API_KEY=
REFUND_EMAIL_FROM=
# Where replies to transactional email go. Falls back to PUBLIC_SUPPORT_EMAIL
# when unset.
REFUND_EMAIL_REPLY_TO=
# Inbound mail for the sending domain. Resend POSTs each received message to
# /webhooks/inbound-email, which forwards it here. Unset: the webhook returns
# 503 and nothing is forwarded.
RESEND_INBOUND_WEBHOOK_SECRET=
INBOUND_EMAIL_FORWARD_TO=
# Render has one trusted proxy. Use 0 when serving HTTP directly.
REFUND_TRUST_PROXY_HOPS=1
# Adobe Fonts kit with Proxima Nova for the assistant connection pages (optional)
ADOBE_FONTS_KIT_ID=
# Synthetic merchant sandbox only. Ignored in production, even when set to 1.
# Does not enable actual Gooper payouts or merchant collection.
GOOPER_FUNDED_RETURNS_SANDBOX=0
# Optional: signing secret (32+ chars) for the fake sandbox payment provider's
# webhooks. A random per-process secret is used when unset. Never a live key.
GOOPER_FUNDED_SANDBOX_PROVIDER_SECRET=
