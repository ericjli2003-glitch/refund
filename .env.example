SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
# Refund's own key for sealing, quote signing and customer ID hashing. Unset
# falls back to SHOPIFY_API_SECRET. When changing it, list every earlier value
# (comma-separated) in REFUND_PREVIOUS_SECRETS while records written with it exist.
REFUND_SECRET=
REFUND_PREVIOUS_SECRETS=
SHOPIFY_APP_URL=https://refund.example.com
SCOPES=read_orders,write_orders,read_returns,write_returns,customer_read_customers,customer_read_orders,customer_write_orders,write_app_proxy
DATABASE_URL=postgresql://refund:password@localhost:5432/refund?schema=public
PUBLIC_SUPPORT_EMAIL=
# Render has one trusted proxy. Use 0 when serving HTTP directly.
REFUND_TRUST_PROXY_HOPS=1
