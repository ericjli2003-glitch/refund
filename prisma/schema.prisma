// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StorePolicy {
  shop                    String   @id
  automaticRefundsEnabled Boolean  @default(false)
  returnWindowDays        Int      @default(30)
  maxAutoRefundAmount     String   @default("100.00")
  currencyCode            String   @default("USD")
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Populated only from the authenticated Shopify Admin API.
model MerchantDirectory {
  shop          String   @id
  primaryDomain String   @unique
  name          String
  aliases       String[] @default([])
  discoveryPublished Boolean @default(false)
  verifiedAt    DateTime @default(now())
}

// Shared across HTTP replicas. No raw IP addresses are persisted.
model PublicRateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Expiring ownership prevents overlapping maintenance runs across replicas.
model MaintenanceLease {
  key       String   @id
  owner     String
  expiresAt DateTime
}

// Owner-only, unverified demand signals. Never exposed in merchant/customer APIs.
// One record per normalized merchant per UTC day; not a unique-customer count.
model MerchantOpportunity {
  id            String   @id
  merchantLabel String
  kind          String
  knownShop     String?
  source        String
  reviewStatus  String   @default("UNREVIEWED")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  expiresAt     DateTime

  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([knownShop])
}

// Only a random opaque identifier reaches the browser. OAuth material is encrypted.
model CustomerReturnSession {
  id                  String              @id
  shop                String
  stateHash           String?             @unique
  sealedState         String?
  accessToken         String?
  customerSubjectHash String?
  csrfToken           String
  orderHint           String?
  itemHint            String?
  draftId             String?
  agentRequestId      String?
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  agentGrants         AgentAccessGrant[]
  agentAuthorizations AgentOAuthRequest[]

  @@index([shop, customerSubjectHash])
  @@index([expiresAt])
}

// Each intake keeps a stable reference, including before verification. Credentials
// remain encrypted at rest and are only returned to that verified customer.
model ReturnDraft {
  id                  String   @id @default(uuid())
  shop                String
  customerSubjectHash String?
  intakeKeyHash       String?  @unique
  inputHash           String?
  sealedHints         String?
  stage               String   @default("PURCHASES_FOUND")
  orderId             String?
  orderName           String?
  selectedItems       Json?
  quoteSnapshot       Json?
  sealedQuoteToken    String?
  quoteId             String?
  quoteExpiresAt      DateTime?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([shop, customerSubjectHash, updatedAt])
  @@index([expiresAt])
  @@index([shop, quoteId])
}

model AgentOAuthClient {
  id                String   @id
  sealedInformation String
  createdAt         DateTime @default(now())
}

model AgentOAuthRequest {
  id            String                 @id
  clientId      String
  shop          String
  resource      String
  redirectUri   String
  scopes        String[]
  sealedState   String?
  codeChallenge String
  browserHash   String
  csrfToken     String
  status        String                 @default("PENDING")
  codeHash      String?                @unique
  codeExpiresAt DateTime?
  grantHash     String?
  sessionId     String?
  session       CustomerReturnSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  expiresAt     DateTime
  createdAt     DateTime               @default(now())

  @@index([sessionId])
  @@index([shop])
  @@index([expiresAt])
}

// Refund credentials are separate from the upstream Shopify token. Browser
// session deletion (logout, rotation, redaction, uninstall) removes all grants.
model AgentAccessGrant {
  tokenHash           String                @id
  sessionId           String
  session             CustomerReturnSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop                String
  customerSubjectHash String
  clientId            String
  resource            String
  scopes              String[]
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime              @default(now())

  @@index([sessionId])
  @@index([shop, customerSubjectHash])
  @@index([expiresAt])
}

model AgentReturn {
  id                  String   @id @default(cuid())
  shop                String
  orderId             String
  orderName           String?
  returnId            String?
  refundId            String?
  status              String   @default("IN_PROGRESS")
  returnStatus        String?
  refundStatus        String?
  amount              String?
  currencyCode        String?
  idempotencyKey      String
  requestedLineItems  Json
  customerSubjectHash String
  failureReason       String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shop, idempotencyKey])
  @@index([shop, status, createdAt])
}

model WebhookReceipt {
  id          String   @id
  shop        String
  topic       String
  processedAt DateTime @default(now())

  @@index([shop, processedAt])
}

model PrivacyRequest {
  id                  String    @id
  shop                String
  type                String
  customerSubjectHash String?
  status              String    @default("PENDING")
  reportData          Json
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([shop, status, createdAt])
}
