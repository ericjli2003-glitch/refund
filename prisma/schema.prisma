// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model StorePolicy {
  shop                    String   @id
  automaticRefundsEnabled Boolean  @default(false)
  returnWindowDays        Int      @default(30)
  maxAutoRefundAmount     String   @default("100.00")
  currencyCode            String   @default("USD")
  // Null means restock to the location that fulfilled the order.
  // A value overrides that for merchants routing returns elsewhere.
  returnLocationId        String?
  // Merchant-authored guidance published in quotes, agents.md and the manifest.
  returnInstructions      String?
  returnPolicyUrl         String?
  // IMMEDIATE refunds on customer confirmation; ON_RECEIPT waits until the
  // merchant marks the returned item received.
  refundTiming            String   @default("IMMEDIATE")
  // Customers' store links keep working after their Shopify sign-in ends, once
  // the merchant confirms the return rules below. Shopify's Admin API doesn't
  // apply the store's own return rules, so Refund applies these instead.
  verifiedStoreLinks      Boolean   @default(true)
  restockingFeePercent    String    @default("0")
  returnShippingFee       String    @default("0.00")
  finalSaleCollectionIds  String[]  @default([])
  returnRulesConfirmedAt  DateTime?
  // Set when a signed-in customer's quote shows Shopify applying a fee or
  // final-sale rule these settings lack. Verified links pause until reviewed.
  returnRulesMismatch     String?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt
}

// Populated only from the authenticated Shopify Admin API.
model MerchantDirectory {
  shop          String   @id
  primaryDomain String   @unique
  name          String
  aliases       String[] @default([])
  // Listed by default; the merchant can hide the store from the directory.
  discoveryPublished Boolean @default(true)
  verifiedAt    DateTime @default(now())
}

// Shared across HTTP replicas. No raw IP addresses are persisted.
model PublicRateLimit {
  key       String   @id
  hits      Int
  expiresAt DateTime

  @@index([expiresAt])
}

// Expiring ownership prevents overlapping maintenance runs across replicas.
model MaintenanceLease {
  key       String   @id
  owner     String
  expiresAt DateTime
}

// Owner-only, unverified demand signals. Never exposed in merchant/customer APIs.
// One record per normalized merchant per UTC day; not a unique-customer count.
model MerchantOpportunity {
  id            String   @id
  merchantLabel String
  kind          String
  knownShop     String?
  source        String
  reviewStatus  String   @default("UNREVIEWED")
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  expiresAt     DateTime

  @@index([lastSeenAt])
  @@index([expiresAt])
  @@index([knownShop])
}

// Only a random opaque identifier reaches the browser. OAuth material is encrypted.
model CustomerReturnSession {
  id                  String              @id
  shop                String
  stateHash           String?             @unique
  sealedState         String?
  accessToken         String?
  customerSubjectHash String?
  csrfToken           String
  orderHint           String?
  itemHint            String?
  draftId             String?
  agentRequestId      String?
  linkRequestId       String?
  expiresAt           DateTime
  createdAt           DateTime            @default(now())
  agentGrants         AgentAccessGrant[]
  agentAuthorizations AgentOAuthRequest[]
  storeLinks          AgentStoreLink[]

  @@index([shop, customerSubjectHash])
  @@index([expiresAt])
}

// Each intake keeps a stable reference, including before verification. Credentials
// remain encrypted at rest and are only returned to that verified customer.
model ReturnDraft {
  id                  String   @id @default(uuid())
  shop                String
  customerSubjectHash String?
  intakeKeyHash       String?  @unique
  inputHash           String?
  sealedHints         String?
  stage               String   @default("PURCHASES_FOUND")
  orderId             String?
  orderName           String?
  selectedItems       Json?
  quoteSnapshot       Json?
  sealedQuoteToken    String?
  quoteId             String?
  quoteExpiresAt      DateTime?
  expiresAt           DateTime
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([shop, customerSubjectHash, updatedAt])
  @@index([expiresAt])
  @@index([shop, quoteId])
}

model AgentOAuthClient {
  id                String   @id
  sealedInformation String
  createdAt         DateTime @default(now())
}

model AgentOAuthRequest {
  id            String                 @id
  clientId      String
  // Null for an all-stores connection request.
  shop          String?
  resource      String
  redirectUri   String
  scopes        String[]
  sealedState   String?
  codeChallenge String
  browserHash   String
  csrfToken     String
  status        String                 @default("PENDING")
  codeHash      String?                @unique
  codeExpiresAt DateTime?
  grantHash     String?
  sessionId     String?
  session       CustomerReturnSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  connectionId  String?
  expiresAt     DateTime
  createdAt     DateTime               @default(now())

  @@index([sessionId])
  @@index([shop])
  @@index([expiresAt])
}

// Refund credentials are separate from the upstream Shopify token. Browser
// session deletion (logout, rotation, redaction, uninstall) removes all grants.
model AgentAccessGrant {
  tokenHash           String                 @id
  // Opaque identifier for customer revoke controls; never derived from a token.
  publicId            String                 @unique @default(dbgenerated("(gen_random_uuid())::text"))
  refreshTokenHash    String?                @unique
  refreshExpiresAt    DateTime?
  rotatedToTokenHash  String?
  // A single-store grant has a session, shop and customer; an all-stores
  // grant has a connection instead.
  sessionId           String?
  session             CustomerReturnSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  shop                String?
  customerSubjectHash String?
  connectionId        String?
  connection          AgentConnection?       @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  clientId            String
  resource            String
  scopes              String[]
  expiresAt           DateTime
  revokedAt           DateTime?
  createdAt           DateTime               @default(now())

  @@index([sessionId])
  @@index([shop, customerSubjectHash])
  @@index([connectionId])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
}

// One assistant connection covering every Refund store. It holds no Shopify
// credential; each linked store keeps its own customer session.
model AgentConnection {
  id           String                  @id @default(uuid())
  clientId     String
  scopes       String[]
  // The browser that approved the connection; store links complete only there.
  browserHash  String
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime                @default(now())
  grants       AgentAccessGrant[]
  stores       AgentStoreLink[]
  linkRequests AgentStoreLinkRequest[]
  emailChecks  EmailVerification[]

  @@index([expiresAt])
}

// A one-tap email confirmation that links a store without a Shopify sign-in.
// NO_ORDERS rows record an email sent to an address with no matching order,
// so sending stays rate limited without revealing that in chat.
model EmailVerification {
  id           String          @id
  connectionId String
  connection   AgentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shop         String
  sealedEmail  String
  emailHash    String
  matchNumber  Int
  csrfToken    String
  status       String          @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime        @default(now())

  @@index([connectionId, createdAt])
  @@index([shop, emailHash, createdAt])
  @@index([expiresAt])
}

model AgentStoreLink {
  id                  String                 @id @default(uuid())
  connectionId        String
  connection          AgentConnection        @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shop                String
  customerSubjectHash String
  // SHOPIFY: a Shopify sign-in verified the customer ID. EMAIL: the customer
  // confirmed the email on their order.
  verifiedBy          String                 @default("SHOPIFY")
  // The verified Shopify customer ID or order email, encrypted.
  sealedCustomerId    String?
  sealedEmail         String?
  // That sign-in, while it lasts.
  sessionId           String?
  session             CustomerReturnSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  lastUsedAt          DateTime               @default(now())
  createdAt           DateTime               @default(now())

  @@unique([connectionId, shop])
  @@index([sessionId])
  @@index([shop])
  @@index([shop, customerSubjectHash])
}

model AgentStoreLinkRequest {
  id           String          @id
  connectionId String
  connection   AgentConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  shop         String
  csrfToken    String
  status       String          @default("PENDING")
  expiresAt    DateTime
  createdAt    DateTime        @default(now())

  @@index([connectionId])
  @@index([shop])
  @@index([expiresAt])
}

model AgentReturn {
  id                  String   @id @default(cuid())
  shop                String
  orderId             String
  orderName           String?
  returnId            String?
  refundId            String?
  status              String   @default("IN_PROGRESS")
  returnStatus        String?
  refundStatus        String?
  amount              String?
  currencyCode        String?
  idempotencyKey      String
  requestedLineItems  Json
  customerSubjectHash String
  failureReason       String?
  // The store's refund timing when the customer confirmed; null before it existed.
  refundTiming        String?
  itemReceivedAt      DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([shop, idempotencyKey])
  @@index([shop, status, createdAt])
}

model WebhookReceipt {
  id          String   @id
  shop        String
  topic       String
  processedAt DateTime @default(now())

  @@index([shop, processedAt])
}

model PrivacyRequest {
  id                  String    @id
  shop                String
  type                String
  customerSubjectHash String?
  status              String    @default("PENDING")
  reportData          Json
  createdAt           DateTime  @default(now())
  completedAt         DateTime?

  @@index([shop, status, createdAt])
}
