    "config:use": "shopify app config use",
    "env": "shopify app env",
    "start": "node ./build/http/index.js",
    "start:production": "prisma migrate deploy && npm run start",
    "setup": "prisma generate && prisma migrate deploy",
    "prisma:validate": "prisma validate",
    "lint": "eslint --ignore-path .gitignore --cache --cache-location ./node_modules/.cache/eslint .",
    "test": "vite-node --config vite.test.config.ts --script app/test.ts",
    "funded:worker": "vite-node --config vite.test.config.ts scripts/funded-payments-worker.ts",
