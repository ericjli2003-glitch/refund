{
  "name": "refund",
  "private": true,
  "scripts": {
    "opportunities": "node scripts/merchant-opportunities.mjs",
    "build": "react-router build && node scripts/build-http.mjs",
    "dev": "shopify app dev",
    "config:link": "shopify app config link",
    "generate": "shopify app generate",
    "deploy": "node scripts/deploy.mjs",
    "storefront:configure": "node scripts/configure-storefront.mjs",
    "storefront:check": "node scripts/configure-storefront.mjs --check",
    "test:infrastructure": "vite-node --config vite.test.config.ts tests/public-infrastructure.integration.ts",
    "test:live-discovery": "node scripts/test-live-discovery.mjs",
    "test:proxy": "vite-node --config vite.test.config.ts tests/merchant-proxy.integration.ts",
