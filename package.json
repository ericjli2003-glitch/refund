    "test:oauth": "vite-node --config vite.test.config.ts tests/agent-oauth.integration.ts",
    "shopify": "shopify",
    "prisma": "prisma",
    "graphql-codegen": "graphql-codegen",
    "vite": "vite",
    "typecheck": "react-router typegen && tsc --noEmit"
  },
